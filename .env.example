# Copy file này thành .env và điền giá trị thật (không commit .env)

# --- PostgreSQL ---
POSTGRES_USER=qltv_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=qltv
POSTGRES_PORT=5432
DATABASE_URL=postgresql://qltv_user:change_me@postgres:5432/qltv

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Auth ---
JWT_SECRET=change_me_to_a_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=7

# --- Backend ---
BACKEND_PORT=8000

# --- Frontend ---
FRONTEND_PORT=5173
